{
  "name": "@microbit/sanity-plugin-python-editor-v3",
  "version": "0.0.0-local",
  "description": "Sanity schemas for the micro:bit Python Editor V3",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "Micro:bit Educational Foundation <package-help@microbit.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microbit-foundation/sanity-plugin-python-editor-v3.git"
  },
  "type": "module",
  "sideEffects": false,
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "packageManager": "npm@11.19.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run format:check && npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "@microbit/eslint-config": "^0.2.1",
    "@sanity/icons": "^5.0.0",
    "@sanity/ui": "^4.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.2.5",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.14.1",
    "styled-components": "^6.1.15",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "@sanity/icons": "^5",
    "@sanity/ui": "^4",
    "react": "^19.2.2",
    "sanity": "^6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
