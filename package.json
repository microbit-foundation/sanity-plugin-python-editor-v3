{
  "name": "@microbit/sanity-plugin-python-editor-v3",
  "version": "0.0.0-local",
  "description": "Sanity schemas for the micro:bit Python Editor V3",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "Micro:bit Educational Foundation <package-help@microbit.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microbit-foundation/sanity-plugin-python-editor-v3.git"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/incompatible-plugin": "^1.0.4",
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^7.0.4",
    "@sanity/plugin-kit": "^4.0.19",
    "@types/react": "^19",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-sanity": "^7.1.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "prettier-plugin-packagejson": "^2.4.12",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-is": "^19.0.0",
    "rimraf": "^5.0.5",
    "sanity": "^6.14.1",
    "typescript": "^5.4.2"
  },
  "peerDependencies": {
    "react": "^19",
    "sanity": "^6",
    "@sanity/ui": "^4"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "sideEffects": true
}
